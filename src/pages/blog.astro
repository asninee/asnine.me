---
import Post from '@components/Post.astro'
import Base from '@layouts/Base.astro'
import { getPosts } from '@lib/posts'
import type { CollectionEntry } from 'astro:content'

const title = 'blog • asnine'

type Posts = {
  [year: string]: CollectionEntry<'blog'>[]
}

const posts = (await getPosts()).reduce((acc: Posts, p) => {
  const year = (p.data.updated ?? p.data.published).getFullYear().toString()
  if (!acc[year]) acc[year] = []
  acc[year].push(p)

  return acc
}, {})

const years = Object.keys(posts).toSorted((a, b) => parseInt(b) - parseInt(a))
---

<Base
  {title}
  description='a collection of all my extended thoughts and experiences'
>
  <h1 class='sr-only'>Blog</h1>
  {years.map(y => (
    <section class='[&:not(:first-of-type)]:mt-8'>
      <small class='text-sec'>{y}</small>
      <ul class='mt-2'>
        {posts[y].map(p => (
          <li>
            <Post
              slug={p.id}
              title={p.data.title}
              desc={p.data.desc}
              date={p.data.updated ?? p.data.published}
              dateFormat='short'
            />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
