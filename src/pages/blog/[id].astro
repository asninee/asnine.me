---
import Badge from '@components/Badge.astro'
import Link from '@components/Link.astro'
import SectionList from '@components/SectionList.astro'
import SectionListItem from '@components/SectionListItem.astro'
import TableOfContents from '@components/TableOfContents.astro'
import Version from '@components/Version.astro'
import VersionItem from '@components/VersionItem.astro'
import Base from '@layouts/Base.astro'
import { formatDate } from '@lib/date'
import { getPosts } from '@lib/posts'
import { render } from 'astro:content'

export const getStaticPaths = async () => {
  const posts = await getPosts(false)
  return posts.map((post, index, allPosts) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: allPosts[index + 1],
      nextPost: allPosts[index - 1],
    },
  }))
}

const {
  post,
  post: {
    data: { title, desc, published, updated },
  },
  prevPost,
  nextPost,
} = Astro.props
const { Content, headings } = await render(post)
const displayDate = updated ?? published
const dateLabel = updated ? 'upd.' : 'pub.'

export const components = {
  a: Link,
  Link,
  Version,
  VersionItem,
  Badge,
  SectionList,
  SectionListItem,
}
---

<Base title=`${title} • asnine` description={desc}>
  <TableOfContents headings={headings} />
  <header>
    <h1 class='mb-2'>{title}</h1>
    <div class='flex items-center gap-1'>
      <Badge>{dateLabel}</Badge>
      <time class='text-sec' datetime={displayDate.toISOString()}>
        {formatDate(displayDate, true)}
      </time>
    </div>
  </header>

  <article class='md mt-6 flex flex-col gap-4 md:mt-8 md:gap-5'>
    <Content components={components} />
  </article>

  <hr />

  <nav aria-label='Post pagination' class='flex items-center'>
    {
      prevPost && (
        <Link
          alternate
          lg
          href={`/blog/${prevPost.id}`}
          class='flex flex-col gap-1'
          noUnderline
        >
          <small class='text-sec'>Previous</small>
          <small>{prevPost.data.title}</small>
        </Link>
      )
    }
    {
      nextPost && (
        <Link
          alternate
          lg
          href={`/blog/${nextPost.id}`}
          class='ml-auto flex flex-col items-end gap-1'
          noUnderline
        >
          <small class='text-sec'>Next</small>
          <small>{nextPost.data.title}</small>
        </Link>
      )
    }
  </nav>
</Base>
