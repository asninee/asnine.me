---
import Link from './Link.astro'

const { url, name, desc, year } = Astro.props
---

<Link
  alternate
  lg
  href={url}
  class='flex items-center justify-between gap-3'
  noUnderline
>
  <span class='font-medium'>{name}</span>
  <span class='text-sec -ml-2 hidden sm:inline'>{desc}</span>
  <div class='border-bor grow border-b border-dotted'></div>
  <time class='text-sec text-xs' datetime={String(year)}>{year}</time>
</Link>
