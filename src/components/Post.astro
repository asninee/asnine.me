---
import { formatDate, type DateFormat } from '@lib/date'
import Link from './Link.astro'

interface Props {
  slug: string
  title: string
  desc: string
  date: Date
  dateFormat: DateFormat
}

const { slug, title, desc, date, dateFormat } = Astro.props
---

<Link
  alternate
  lg
  href={`/blog/${slug}`}
  class='flex items-center justify-between gap-4'
  noUnderline
>
  <span class='font-medium'>
    {title}
    <span class='text-sec hidden font-normal sm:block'>{desc}</span>
  </span>

  <time class='text-sec text-xs' datetime={date.toISOString()}>
    {formatDate(date, dateFormat)}
  </time>
</Link>
