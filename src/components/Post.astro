---
import { formatDate } from '@lib/date'
import Link from './Link.astro'

const { slug, title, desc, date } = Astro.props

const isHome = Astro.url.pathname === '/'
---

<Link
  alternate
  lg
  href={`/blog/${slug}`}
  class='flex items-center justify-between gap-4'
  noUnderline
>
  <span class='font-medium'>
    {title}
    <span class='text-sec hidden font-normal sm:block'>
      {desc}
    </span>
  </span>

  <time class='text-sec text-xs' datetime={date.toISOString()}>
    {formatDate(date, isHome)}
  </time>
</Link>
