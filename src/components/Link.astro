---
const {
  href,
  lg,
  alternate,
  nav,
  noUnderline,
  class: className,
  ...props
} = Astro.props

const isExternal = href.startsWith('http')
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class:list={[
    nav
      ? 'text-sec -mx-1 px-1 py-0 hover:text-black dark:hover:text-white'
      : lg
        ? '-mx-2 p-2'
        : '-mx-1 p-1',
    alternate && 'transition-opacity duration-300 hover:opacity-45',
    !noUnderline &&
      'decoration-bor underline underline-offset-2 hover:decoration-neutral-400 dark:hover:decoration-neutral-500',
    className,
  ]}
  {...props}><slot /></a
>
