---
import Link from './Link.astro'

const { name, date, href } = Astro.props
---

<section class='flex items-center gap-6'>
  <div class='flex flex-col items-center'>
    {
      href ? (
        <h2 class='m-0 font-normal'>
          <Link class='text-lg' href={href}>
            {name}
          </Link>
        </h2>
      ) : (
        <h2 class='m-0 text-lg font-normal'>{name}</h2>
      )
    }
    <small class='text-sec'>{date}</small>
  </div>
  <div class='border-bor flex flex-col gap-2 border-l pl-7'>
    <slot />
  </div>
</section>
